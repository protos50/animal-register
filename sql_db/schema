    LANGUAGE plpgsql COST 50 ROWS 100 PARALLEL SAFE
    AS $$
BEGIN
	RETURN QUERY
	SELECT
		L.LOCALITY_NAME AS LOCALITY,
		D.DEPARTMENT_NAME AS DEPARTMENT,
